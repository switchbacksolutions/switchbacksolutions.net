---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

---

<BaseLayout title="About — Switchback Solutions">
  <Header />

  <main class="about-page">

    <!-- Intro -->
    <section class="intro-section">
      <div class="container">
        <h1 class="page-title">About Us</h1>
        <p class="lead">
          We're Alec and Sarah — co-founders of Switchback Solutions. Between us, we've spent close to three decades building software, scaling engineering teams, and helping companies figure out what to build — and how to build it well.
        </p>
      </div>
    </section>

    <!-- Bios -->
    <section class="bios-section">
      <div class="container">
        <div class="bios-grid">

          <!-- Alec -->
          <article class="bio-card">
            <img class="bio-photo" src="/images/alec-reynolds.jpeg" alt="Alec Reynolds" />
            <h2 class="bio-name">Alec Reynolds</h2>
            <p class="bio-role">Co-Founder &amp; Fractional CTO</p>
            <div class="bio-text">
              <p>
                My career started in the San Francisco startup scene, where I learned what it looks like when technology and product thinking are firing on all cylinders — and what it costs when they're not. That experience shaped everything I've built since: two revenue-funded consultancies scaled to seven-figure annual revenue, a decade of leading multidisciplinary teams through complex web application challenges in healthcare, finance, education, and beyond.
              </p>
              <p>
                More recently, I've been building <a href="https://lando.dev" target="_blank" rel="noopener">Lando</a> — a developer experience platform built on Docker and Node.js that makes local development dramatically simpler. With over 13,000 active monthly users, it's become a standard part of the development workflow for teams around the world.
              </p>
              <p>
                Today, my focus is AI-first software development. The tools available to engineering teams have fundamentally shifted, but the strategic question of <em>what</em> to build with them — and where AI actually moves the needle — still requires experienced judgment. I work with early-stage founders and forward-thinking companies as their drop-in technical leader: shaping product decisions, architecting systems, and building alongside teams that are ready to move.
              </p>
              <p>
                My natural habitat is the Sierra Nevada foothills, where I spend my time trail running, camping with my family, and tending a garden that's always more ambitious than the season allows. The same instinct that draws me to the mountains — knowing when to push, when to rest, and how to read the terrain — shows up in how I work with clients.
              </p>
            </div>
          </article>

          <!-- Sarah -->
          <article class="bio-card">
            <img class="bio-photo" src="/images/sarah-reynolds.jpeg" alt="Sarah Reynolds" />
            <h2 class="bio-name">Sarah Reynolds</h2>
            <p class="bio-role">Co-Founder &amp; Fractional CTO</p>
            <div class="bio-text">
              <p>
                I started out in 2010 as a freelance developer, doing whatever the internet needed back then — Rails, WordPress, Drupal, jQuery, the works. That scrappy, do-everything era taught me more about shipping software than any classroom could.
              </p>
              <p>
                In 2012, I joined <a href="https://en.wikipedia.org/wiki/Crohnology" target="_blank" rel="noopener">Crohnology</a> as CTO — a YC and Rock Health-backed startup with a mission I believed in. I built features, learned to manage a team, and got my first real taste of what it means to own a product's technical direction end to end.
              </p>
              <p>
                From there I spent seven-plus years at Omada Health, starting as a software architect on the participant-facing app before spinning out and leading the B2B side — eligibility, billing, and reporting. As Director and then Senior Director of Engineering, I built and led the data engineering and growth teams and managed infrastructure, B2B, and billing — helping grow the engineering org from about 10 people to more than 70.
              </p>
              <p>
                Most recently, I co-founded Millie, where I spent four years as CTO building the technical foundation of an early-stage company from scratch — the same kind of ground-floor work I now bring to the founders and teams I work with at Switchback.
              </p>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- Highlights -->
    <section class="highlights-section">
      <div class="container">
        <div class="highlights-grid">
          <div class="highlight">
            <div class="highlight-number">30+</div>
            <div class="highlight-label">Combined years building and leading engineering teams</div>
          </div>
          <div class="highlight">
            <div class="highlight-number">70+</div>
            <div class="highlight-label">Grew Omada Health's engineering org from ~10 to 70+ engineers, under Sarah's leadership</div>
          </div>
          <div class="highlight">
            <div class="highlight-number">13K+</div>
            <div class="highlight-label">Active monthly users of Lando, an open source developer tool Alec created</div>
          </div>
          <div class="highlight">
            <div class="highlight-number">4</div>
            <div class="highlight-label">Startups where one of us has served as founding or fractional CTO</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical background -->
    <section class="technical-section">
      <div class="container">
        <h2 class="section-title">Technical Background</h2>
        <div class="technical-content">
          <p>
            Between us, we're fluent across the modern web stack — Node.js, Python, Ruby on Rails, PHP (Laravel, Symfony, Drupal), and the infrastructure that runs it all (Docker, AWS). We've designed and built HIPAA-compliant systems for healthcare platforms, architected pipelines for AI/ML and data engineering workloads, stood up billing and B2B systems from scratch, and set up DevOps foundations that let small teams punch well above their weight.
          </p>
          <p>
            We're deliberately tech-agnostic in our practice. The right stack is the one that fits the team, the constraints, and the problem — not the one that's trending. Our portfolio speaks to that range better than any list of logos.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container">
        <h2>Ready to Build Something?</h2>
        <p>If you need a technical partner who can think strategically and build alongside you, let's talk.</p>
        <a href="/contact" class="cta-button-large">Work with Us</a>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .about-page {
    padding-top: 80px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Intro */
  .intro-section {
    padding: 5rem 0 3rem;
    background-color: var(--color-light);
  }

  .page-title {
    font-family: 'Raleway', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }

  .lead {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.7;
    color: var(--color-dark);
    max-width: 760px;
    font-weight: 500;
  }

  /* Bios */
  .bios-section {
    padding: 3rem 0 4rem;
  }

  .bios-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3.5rem;
  }

  .bio-card {
    display: flex;
    flex-direction: column;
  }

  .bio-photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
    margin-bottom: 1.5rem;
  }

  .bio-name {
    font-family: 'Raleway', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .bio-role {
    font-family: 'Source Sans Pro', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-dark);
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }

  .bio-text {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-dark);
  }

  .bio-text p {
    margin-bottom: 1.5rem;
  }

  .bio-text p:last-child {
    margin-bottom: 0;
  }

  .bio-text a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bio-text a:hover {
    opacity: 0.75;
  }

  .bio-text em {
    font-style: italic;
  }

  /* Highlights */
  .highlights-section {
    padding: 4rem 0;
    background-color: var(--color-primary);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 3rem;
  }

  .highlight {
    color: white;
  }

  .highlight-number {
    font-family: 'Raleway', sans-serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .highlight-label {
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  /* Technical */
  .technical-section {
    padding: 4rem 0;
    background-color: var(--color-secondary);
  }

  .section-title {
    font-family: 'Raleway', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }

  .technical-content {
    max-width: 760px;
    font-size: 1.125rem;
    line-height: 1.85;
    color: var(--color-dark);
  }

  .technical-content p {
    margin-bottom: 1.5rem;
  }

  .technical-content p:last-child {
    margin-bottom: 0;
  }

  /* CTA */
  .cta-section {
    padding: 5rem 0;
    text-align: center;
    background-color: var(--color-light);
  }

  .cta-section h2 {
    font-family: 'Raleway', sans-serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .cta-section p {
    font-size: 1.125rem;
    color: var(--color-dark);
    margin-bottom: 2rem;
    opacity: 0.85;
  }

  .cta-button-large {
    display: inline-block;
    background-color: var(--color-accent);
    color: white;
    padding: 1.25rem 2.5rem;
    border-radius: 6px;
    font-family: 'Source Sans Pro', sans-serif;
    font-weight: 500;
    font-size: 1.125rem;
    transition: background-color 0.2s, transform 0.2s;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .cta-button-large:hover {
    background-color: #d4944a;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .bios-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .intro-section {
      padding: 4rem 0 2.5rem;
    }

    .bios-section {
      padding: 2rem 0 3rem;
    }

    .technical-section,
    .cta-section {
      padding: 3rem 0;
    }

    .highlights-section {
      padding: 3rem 0;
    }

    .highlights-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .container {
      padding: 0 1.5rem;
    }

  }

  @media (max-width: 480px) {
    .highlights-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
